EMAIL_ORGANIZER_API_USERNAME=
EMAIL_ORGANIZER_API_PASSWORD=

# Credenciais da pessoa que usa o App e vínculo com EMAIL_SYNC_ACCOUNT.
EMAIL_ORGANIZER_APP_USERNAME=
EMAIL_ORGANIZER_APP_PASSWORD_HASH=
EMAIL_ORGANIZER_APP_GMAIL_ACCOUNT=

# Caminhos absolutos para o cliente OAuth e o diretório de tokens do importador.
EMAIL_ORGANIZER_APP_GMAIL_CREDENTIALS_PATH=
EMAIL_ORGANIZER_APP_GMAIL_TOKENS_PATH=

# Autorização separada para a Lixeira, criada com ./gradlew authorizeGmailTrash.
EMAIL_ORGANIZER_APP_GMAIL_TRASH_CREDENTIALS_PATH=
EMAIL_ORGANIZER_APP_GMAIL_TRASH_TOKENS_PATH=
